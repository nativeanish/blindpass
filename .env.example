DATABASE_URL=postgres://blindpass:blindpass-local-only@localhost:5432/blindpass
BLINDPASS_ENV=development
API_PORT=3001
ISSUER_ORIGIN=localhost:3000
ZCASH_NETWORK=testnet
ZCASH_PAYMENT_MODE=mock
# Generated locally in .secrets/ for development. Production requires explicit keys.
MERCHANT_CONFIG_PRIVATE_KEY=
MERCHANT_CONFIG_PUBLIC_KEY=
PRIVACYPASS_ISSUER_SECRET=
BLINDPASS_PINNED_FINGERPRINT=
NEXT_PUBLIC_BLINDPASS_FINGERPRINT=
PRIVACYPASS_ISSUER_EPOCH=
# JSON map of previous epoch names to base64url private keys, retained only through grace.
PRIVACYPASS_PREVIOUS_KEYS=
# Set true only after a deliberate mainnet review.
BLINDPASS_ALLOW_MAINNET=false
# Scanner bridge (see docs/zcash.md); never supply a spending key.
ZCASH_SCANNER_URL=
ZCASH_SCANNER_API_KEY=
ZCASH_WEBHOOK_SECRET=
ZCASH_VIEWING_KEY=
CIPHERPAY_API_URL=
CIPHERPAY_API_KEY=
TOR_PROXY=socks5h://127.0.0.1:9050
# Optional CLI vault passphrase; otherwise Linux Secret Service is attempted.
BLINDPASS_VAULT_PASSWORD=
