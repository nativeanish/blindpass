# Copy to .env.production and fill all required values. Never commit it.
# Optional immutable registry tags for distributing builds to other hosts.
BLINDPASS_API_IMAGE=blindpass-api:local
BLINDPASS_WEB_IMAGE=blindpass-web:local
BLINDPASS_ENV=production
ISSUER_ORIGIN=search.your-domain.com
ACME_EMAIL=
SUPPORT_URL=
# Use a long URL-safe random password, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# Generate once with `./scripts/deploy.sh init`; copy its PUBLIC fingerprint here.
NEXT_PUBLIC_BLINDPASS_FINGERPRINT=
ZCASH_PAYMENT_MODE=scanner
ZCASH_NETWORK=testnet
# Public origins of other network deployments (HTTPS, no path). Optional.
BLINDPASS_SIMULATION_URL=
BLINDPASS_DEVNET_URL=
BLINDPASS_MAINNET_URL=
ZCASH_CONFIRMATIONS=3
ZCASH_SCANNER_URL=
ZCASH_SCANNER_API_KEY=
ZCASH_WEBHOOK_SECRET=
# Enable only when the live scanner and payment flow have been verified.
BLINDPASS_ALLOW_MAINNET=false
RATE_LIMIT_PER_MINUTE=600
PURCHASE_LIMIT_PER_MINUTE=30
RECONCILIATION_INTERVAL_MS=30000
