# Local Zcash testnet workspace. Copy to .env.devnet and fill the scanner fields.
# Use with infra/compose.scanner.yml, not the simulation stack.
BLINDPASS_NETWORK_PROJECT=blindpass-devnet
BLINDPASS_WEB_PORT=3400
BLINDPASS_API_PORT=3401
POSTGRES_PORT=55436
POSTGRES_PASSWORD=
ISSUER_ORIGIN=localhost:3400
ZCASH_NETWORK=testnet
ZCASH_SCANNER_URL=
ZCASH_SCANNER_API_KEY=
ZCASH_WEBHOOK_SECRET=
ZCASH_CONFIRMATIONS=3
BLINDPASS_ALLOW_MAINNET=false
BLINDPASS_SIMULATION_URL=http://localhost:3100
# Fill only after the other scanner-backed workspace has been checked.
BLINDPASS_DEVNET_URL=
BLINDPASS_MAINNET_URL=
