{
  email {$ACME_EMAIL}
  admin off
  # HTTP error logs can contain URLs and bearer capabilities as well.
  log {
    output discard
  }
}
{$ISSUER_ORIGIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    -Server
  }
  @api path /api/* /.well-known/* /webhooks/*
  handle @api {
    reverse_proxy api:3001
  }
  handle {
    reverse_proxy web:3000
  }
}
